file(GLOB _modules "${CLIENT_BUILD}/mooncake-integration/store*.so")
list(LENGTH _modules _module_count)
if(NOT _module_count EQUAL 1)
  message(FATAL_ERROR "Expected one pinned Mooncake Python module, found ${_module_count}")
endif()
file(MAKE_DIRECTORY "${CLIENT_DEST}/python/mooncake" "${CLIENT_DEST}/bin")
file(COPY ${_modules} DESTINATION "${CLIENT_DEST}/python/mooncake")
file(COPY "${CLIENT_BUILD}/mooncake-common/libasio.so" DESTINATION "${CLIENT_DEST}/python/mooncake")
file(COPY "${CLIENT_BUILD}/mooncake-common/libasio.so" DESTINATION "${CLIENT_DEST}/bin")
file(COPY "${CLIENT_BUILD}/mooncake-store/src/mooncake_master" DESTINATION "${CLIENT_DEST}/bin")
file(WRITE "${CLIENT_DEST}/python/mooncake/__init__.py" "# Optional pinned Maya state-cache transport.\n")
message(STATUS "Mooncake client: set PYTHONPATH=${CLIENT_DEST}/python for the matching Python interpreter")

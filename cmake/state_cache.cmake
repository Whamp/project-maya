find_package(Threads REQUIRED)
add_library(strata_state_cache STATIC src/core/state_cache.cpp src/core/state_digest.cpp)
target_include_directories(strata_state_cache PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)
target_compile_features(strata_state_cache PUBLIC cxx_std_20)
target_link_libraries(strata_state_cache PUBLIC Threads::Threads)
find_package(OpenSSL QUIET)
if(OpenSSL_FOUND)
  target_link_libraries(strata_state_cache PRIVATE OpenSSL::Crypto)
  target_compile_definitions(strata_state_cache PRIVATE STRATA_STATE_OPENSSL=1)
endif()
if(STRATA_BUILD_TESTS)
  enable_testing()
  add_executable(state_cache_test tests/core/state_cache_test.cpp)
  target_link_libraries(state_cache_test PRIVATE strata_state_cache)
  add_test(NAME state_cache_test COMMAND state_cache_test)
endif()
